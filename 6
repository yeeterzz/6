using System;
using System.Collections.Generic;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class ClientsPage : Page
    {
        public ClientsPage()
        {
            InitializeComponent();
            LoadData();
        }

        // Загрузка данных из БД при открытии страницы
        void LoadData()
        {
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    DataList.ItemsSource = (from c in db.Clients
                                            join u0 in db.Users on c.UserId equals u0.Id into uj
                                            from u in uj.DefaultIfEmpty()
                                            orderby c.Id
                                            select new { c.Id, c.FullName, c.Phone, c.Email, Login = u.Login ?? "—" }).ToList();
                }
            }
            catch (Exception ex) { Helpers.ShowError("Ошибка загрузки данных: " + ex.GetBaseException().Message); }
        }

        void DataList_DoubleClick(object sender, System.Windows.Input.MouseButtonEventArgs e)
        {
            if (EditBtn.Visibility == Visibility.Visible && DataList.SelectedItem != null)
                Edit_Click(sender, e);
        }

        void Add_Click(object sender, RoutedEventArgs e)
        {
            if (OpenForm(null)) LoadData();
        }

        void Edit_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null) return;
            if (OpenForm(id.Value)) LoadData();
        }

        void Delete_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null || !Helpers.ConfirmDelete()) return;
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    var c = db.Clients.Find(id.Value);
                    if (c != null) { db.Clients.Remove(c); db.SaveChanges(); }
                }
            }
            catch (Exception) { Helpers.ShowError("Запись нельзя удалить: она связана с другими данными (автомобили)."); }
            LoadData();
        }

        // Форма добавления (id == null) или редактирования
        bool OpenForm(int? id)
        {
            using (var db = new AutoServiceEntities())
            {
                var c = id == null ? new Clients() : db.Clients.Find(id.Value);
                var users = (from u in db.Users
                             join r in db.Roles on u.RoleId equals r.Id
                             where r.Name == "Клиент"
                             select new { u.Id, u.Login }).ToList()
                            .Select(x => new KeyValuePair<int, string>(x.Id, x.Login));

                var fields = new List<FormField> {
                    new FormField { Key = "FullName", Label = "ФИО", Value = c.FullName },
                    new FormField { Key = "Phone", Label = "Телефон", Value = c.Phone, Nullable = true },
                    new FormField { Key = "Email", Label = "Email", Value = c.Email, Nullable = true },
                    new FormField { Key = "UserId", Label = "Учётная запись (клиент)", Kind = Kind.Lookup,
                                    Items = Helpers.Pairs(true, users), Value = c.UserId ?? 0, Nullable = true }
                };
                var form = new FormWindow(id == null ? "Добавление клиента" : "Редактирование клиента", fields, v =>
                {
                    c.FullName = (string)v["FullName"];
                    c.Phone = (string)v["Phone"];
                    c.Email = (string)v["Email"];
                    c.UserId = Helpers.N(v["UserId"]);
                    if (id == null) db.Clients.Add(c);   // INSERT
                    db.SaveChanges();                     // UPDATE для существующей записи
                    return null;
                });
                return form.ShowDialog() == true;
            }
        }
    }
}



