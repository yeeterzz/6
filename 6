using System;
using System.Collections.Generic;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class OrdersPage : Page
    {
        static readonly string[] Statuses = { "Новый", "В работе", "Готов", "Выдан" };

        public OrdersPage()
        {
            InitializeComponent();
            if (Session.Role == Session.Client) TitleText.Text = "Мои заказы";
            // Админ: полный CRUD; мастер: только меняет статус; клиент: только просмотр
            AddBtn.Visibility = DelBtn.Visibility = Session.Role == Session.Admin ? Visibility.Visible : Visibility.Collapsed;
            EditBtn.Visibility = Session.Role != Session.Client ? Visibility.Visible : Visibility.Collapsed;
            LoadData();
        }

        void LoadData()
        {
            int uid = Session.UserId;
            string role = Session.Role;
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    var q = from o in db.Orders
                            join ca in db.Cars on o.CarId equals ca.Id
                            join cl in db.Clients on ca.ClientId equals cl.Id
                            join s in db.Services on o.ServiceId equals s.Id
                            join m0 in db.Users on o.MasterId equals m0.Id into mj
                            from m in mj.DefaultIfEmpty()
                            select new
                            {
                                o.Id,
                                Client = cl.FullName,
                                Car = ca.Brand + " " + ca.Model + " (" + ca.PlateNumber + ")",
                                Service = s.Name,
                                Master = m.FullName ?? "—",
                                o.OrderDate,
                                o.Status,
                                o.MasterId,
                                ClientUserId = cl.UserId
                            };
                    if (role == Session.Master) q = q.Where(x => x.MasterId == uid);       // мастер – свои заказы
                    if (role == Session.Client) q = q.Where(x => x.ClientUserId == uid);   // клиент – свои заказы
                    DataList.ItemsSource = q.OrderBy(x => x.Id).ToList();
                }
            }
            catch (Exception ex) { Helpers.ShowError("Ошибка загрузки данных: " + ex.GetBaseException().Message); }
        }

        void DataList_DoubleClick(object sender, System.Windows.Input.MouseButtonEventArgs e)
        {
            if (EditBtn.Visibility == Visibility.Visible && DataList.SelectedItem != null)
                Edit_Click(sender, e);
        }

        void Add_Click(object sender, RoutedEventArgs e)
        {
            if (OpenForm(null)) LoadData();
        }

        void Edit_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null) return;
            if (OpenForm(id.Value)) LoadData();
        }

        void Delete_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null || !Helpers.ConfirmDelete()) return;
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    var o = db.Orders.Find(id.Value);
                    if (o != null) { db.Orders.Remove(o); db.SaveChanges(); }
                }
            }
            catch (Exception) { Helpers.ShowError("Не удалось удалить заказ."); }
            LoadData();
        }

        bool OpenForm(int? id)
        {
            bool onlyStatus = Session.Role == Session.Master;   // мастер меняет только статус
            using (var db = new AutoServiceEntities())
            {
                var o = id == null ? new Orders { OrderDate = DateTime.Today, Status = "Новый" } : db.Orders.Find(id.Value);

                var cars = (from ca in db.Cars
                            join cl in db.Clients on ca.ClientId equals cl.Id
                            select new { ca.Id, ca.Brand, ca.Model, cl.FullName }).ToList()
                           .Select(x => new KeyValuePair<int, string>(x.Id, x.Brand + " " + x.Model + " — " + x.FullName));
                var services = db.Services.ToList().Select(x => new KeyValuePair<int, string>(x.Id, x.Name));
                var masters = (from u in db.Users
                               join r in db.Roles on u.RoleId equals r.Id
                               where r.Name == "Мастер"
                               select new { u.Id, u.FullName }).ToList()
                              .Select(x => new KeyValuePair<int, string>(x.Id, x.FullName));

                var fields = new List<FormField> {
                    new FormField { Key = "CarId", Label = "Автомобиль", Kind = Kind.Lookup,
                                    Items = Helpers.Pairs(false, cars), Value = id == null ? 0 : o.CarId, Enabled = !onlyStatus },
                    new FormField { Key = "ServiceId", Label = "Услуга", Kind = Kind.Lookup,
                                    Items = Helpers.Pairs(false, services), Value = id == null ? 0 : o.ServiceId, Enabled = !onlyStatus },
                    new FormField { Key = "MasterId", Label = "Мастер", Kind = Kind.Lookup, Nullable = true,
                                    Items = Helpers.Pairs(true, masters), Value = o.MasterId ?? 0, Enabled = !onlyStatus },
                    new FormField { Key = "OrderDate", Label = "Дата заказа", Kind = Kind.Date,
                                    Value = o.OrderDate, Enabled = !onlyStatus },
                    new FormField { Key = "Status", Label = "Статус", Kind = Kind.Choice,
                                    Choices = Statuses, Value = o.Status }
                };
                var form = new FormWindow(id == null ? "Добавление заказа" : "Редактирование заказа", fields, v =>
                {
                    o.Status = (string)v["Status"];
                    if (!onlyStatus)
                    {
                        o.CarId = (int)v["CarId"];
                        o.ServiceId = (int)v["ServiceId"];
                        o.MasterId = Helpers.N(v["MasterId"]);
                        o.OrderDate = (DateTime)v["OrderDate"];
                    }
                    if (id == null) db.Orders.Add(o);
                    db.SaveChanges();
                    return null;
                });
                return form.ShowDialog() == true;
            }
        }
    }
}



