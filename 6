using System;
using System.Collections.Generic;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class MainPage : Page
    {
        static KeyValuePair<string, Func<Page>> Nav(string title, Func<Page> factory)
        {
            return new KeyValuePair<string, Func<Page>>(title, factory);
        }

        public MainPage()
        {
            InitializeComponent();
            FioText.Text = Session.FullName;
            RoleText.Text = Session.Role;

            // Разграничение прав: какие разделы видит каждая роль
            var items = new List<KeyValuePair<string, Func<Page>>>();
            if (Session.Role == Session.Admin)
            {
                items.Add(Nav("Клиенты", () => new ClientsPage()));
                items.Add(Nav("Автомобили", () => new CarsPage()));
                items.Add(Nav("Услуги", () => new ServicesPage()));
                items.Add(Nav("Заказы", () => new OrdersPage()));
                items.Add(Nav("Пользователи", () => new UsersPage()));
            }
            else if (Session.Role == Session.Master)
            {
                items.Add(Nav("Заказы", () => new OrdersPage()));
                items.Add(Nav("Услуги", () => new ServicesPage()));
            }
            else // Клиент
            {
                items.Add(Nav("Мои автомобили", () => new CarsPage()));
                items.Add(Nav("Мои заказы", () => new OrdersPage()));
            }

            foreach (var item in items)
            {
                var factory = item.Value;
                var b = new Button
                {
                    Content = item.Key,
                    Padding = new Thickness(14, 4, 14, 4),
                    Margin = new Thickness(0, 0, 8, 0)
                };
                b.Click += (s, ev) => ContentFrame.Navigate(factory());
                NavPanel.Children.Add(b);
            }
            ContentFrame.Navigate(items[0].Value());
        }

        void Logout_Click(object sender, RoutedEventArgs e)
        {
            Session.UserId = 0; Session.FullName = ""; Session.Role = "";
            NavigationService.Navigate(new LoginPage());
        }
    }
}


ШАГ 14. ЗАПУСК И ПРОВЕРКА
-----------------------------------------------------------------------------------------
Ctrl+Shift+B (сборка), затем F5.
  Администратор: Клиенты, Автомобили, Услуги, Заказы, Пользователи — полный CRUD.
  Мастер:        Заказы (только свои; в форме можно изменить только статус) и Услуги
                 (только просмотр).
  Клиент:        «Мои автомобили» и «Мои заказы» — только свои данные, без кнопок.
Удаление всегда спрашивает подтверждение (MessageBox Да/Нет).

КАК ЭТО РАБОТАЕТ (для защиты)
-----------------------------------------------------------------------------------------
  Загрузка:      DataList.ItemsSource = (LINQ-запрос к db.Таблица).ToList();
  Добавить:      форма FormWindow -> db.Таблица.Add(obj); db.SaveChanges();   (INSERT)
  Редактировать: obj = db.Таблица.Find(id); меняем поля; db.SaveChanges();    (UPDATE)
  Удалить:       MessageBox -> db.Таблица.Remove(obj); db.SaveChanges();      (DELETE по Id)
  После сохранения/удаления вызывается LoadData() — список перезагружается.
  Права: кнопки скрываются по Session.Role в конструкторе страницы; клиент и мастер
  видят только свои строки за счёт фильтра в LoadData().

ЕСЛИ НЕ КОМПИЛИРУЕТСЯ
-----------------------------------------------------------------------------------------
* Красным подсвечены Clients/Users/Cars и т.п. или их свойства — в вашей БД другие
  имена. Посмотрите реальные имена классов и свойств в AutoServiceModel.edmx и замените
  в *Page.xaml.cs (и в XAML в {Binding ...}, если меняли имена в запросах).
* Нет Clients.UserId — добавьте столбец в БД и обновите модель (ПКМ по .edmx ->
  Обновить модель из базы данных).
* Если класс называется в единственном числе (Client, Car...), вы не сняли галочку
  при создании модели: пересоздайте модель.
