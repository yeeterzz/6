using System;
using System.Collections.Generic;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class UsersPage : Page
    {
        public UsersPage()
        {
            InitializeComponent();
            LoadData();
        }

        void LoadData()
        {
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    DataList.ItemsSource = (from u in db.Users
                                            join r in db.Roles on u.RoleId equals r.Id
                                            orderby u.Id
                                            select new { u.Id, u.Login, u.FullName, Role = r.Name }).ToList();
                }
            }
            catch (Exception ex) { Helpers.ShowError("Ошибка загрузки данных: " + ex.GetBaseException().Message); }
        }

        void DataList_DoubleClick(object sender, System.Windows.Input.MouseButtonEventArgs e)
        {
            if (EditBtn.Visibility == Visibility.Visible && DataList.SelectedItem != null)
                Edit_Click(sender, e);
        }

        void Add_Click(object sender, RoutedEventArgs e)
        {
            if (OpenForm(null)) LoadData();
        }

        void Edit_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null) return;
            if (OpenForm(id.Value)) LoadData();
        }

        void Delete_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null) return;
            if (id.Value == Session.UserId)
            {
                MessageBox.Show("Нельзя удалить собственную учётную запись", "Внимание");
                return;
            }
            if (!Helpers.ConfirmDelete()) return;
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    var u = db.Users.Find(id.Value);
                    if (u != null) { db.Users.Remove(u); db.SaveChanges(); }
                }
            }
            catch (Exception) { Helpers.ShowError("Пользователя нельзя удалить: он связан с другими данными."); }
            LoadData();
        }

        bool OpenForm(int? id)
        {
            using (var db = new AutoServiceEntities())
            {
                var u = id == null ? new Users() : db.Users.Find(id.Value);
                var roles = db.Roles.ToList().Select(x => new KeyValuePair<int, string>(x.Id, x.Name));

                var fields = new List<FormField> {
                    new FormField { Key = "Login", Label = "Логин", Value = u.Login },
                    new FormField { Key = "Password", Label = "Пароль", Value = u.Password },
                    new FormField { Key = "FullName", Label = "ФИО", Value = u.FullName },
                    new FormField { Key = "RoleId", Label = "Роль", Kind = Kind.Lookup,
                                    Items = Helpers.Pairs(false, roles), Value = id == null ? 0 : u.RoleId }
                };
                var form = new FormWindow(id == null ? "Добавление пользователя" : "Редактирование пользователя", fields, v =>
                {
                    string login = (string)v["Login"];
                    int myId = id ?? 0;
                    if (db.Users.Any(x => x.Login == login && x.Id != myId))
                        return "Пользователь с таким логином уже существует";
                    u.Login = login;
                    u.Password = (string)v["Password"];
                    u.FullName = (string)v["FullName"];
                    u.RoleId = (int)v["RoleId"];
                    if (id == null) db.Users.Add(u);
                    db.SaveChanges();
                    return null;
                });
                return form.ShowDialog() == true;
            }
        }
    }
}



