using System;
using System.Collections.Generic;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public enum Kind { Text, Int, Decimal, Date, Lookup, Choice }

    /// <summary>Одно поле формы добавления/редактирования</summary>
    public class FormField
    {
        public string Key;          // ключ в словаре результата
        public string Label;        // подпись
        public Kind Kind;
        public object Value;        // начальное значение
        public bool Nullable;       // можно оставить пустым
        public bool Enabled = true; // доступно для изменения
        public List<KeyValuePair<int, string>> Items; // для Lookup (Key = Id, 0 = «нет»)
        public string[] Choices;    // для Choice
    }

    public static class Helpers
    {
        // Список для ComboBox; withNone = первой строкой «— нет —» (Id = 0)
        public static List<KeyValuePair<int, string>> Pairs(bool withNone, IEnumerable<KeyValuePair<int, string>> src)
        {
            var list = new List<KeyValuePair<int, string>>();
            if (withNone) list.Add(new KeyValuePair<int, string>(0, "— нет —"));
            list.AddRange(src);
            return list;
        }

        // Id выбранной строки списка (элементы – объекты со свойством Id)
        public static int? SelectedId(ListView list)
        {
            var item = list.SelectedItem;
            if (item == null)
            {
                MessageBox.Show("Выберите запись в списке", "Внимание");
                return null;
            }
            return (int)item.GetType().GetProperty("Id").GetValue(item, null);
        }

        // Подтверждение удаления
        public static bool ConfirmDelete()
        {
            return MessageBox.Show("Удалить выбранную запись?", "Подтверждение удаления",
                MessageBoxButton.YesNo, MessageBoxImage.Question) == MessageBoxResult.Yes;
        }

        public static void ShowError(string m)
        {
            MessageBox.Show(m, "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
        }

        // 0 -> null (для необязательных внешних ключей)
        public static int? N(object o)
        {
            int i = (int)o;
            return i == 0 ? (int?)null : i;
        }
    }

    /// <summary>Универсальная форма: строит поля, проверяет ввод, вызывает save()</summary>
    public class FormWindow : Window
    {
        readonly Dictionary<string, Control> ctl = new Dictionary<string, Control>();
        readonly List<FormField> fields;
        readonly Func<Dictionary<string, object>, string> save;

        public FormWindow(string title, List<FormField> fields, Func<Dictionary<string, object>, string> save)
        {
            this.fields = fields; this.save = save;
            Title = title; Width = 420;
            SizeToContent = SizeToContent.Height;
            ResizeMode = ResizeMode.NoResize;
            WindowStartupLocation = WindowStartupLocation.CenterOwner;
            Owner = Application.Current.MainWindow;

            var panel = new StackPanel { Margin = new Thickness(15) };
            foreach (var f in fields)
            {
                panel.Children.Add(new TextBlock { Text = f.Label, Margin = new Thickness(0, 8, 0, 2) });
                Control c;
                switch (f.Kind)
                {
                    case Kind.Lookup:
                        c = new ComboBox
                        {
                            ItemsSource = f.Items,
                            DisplayMemberPath = "Value",
                            SelectedValuePath = "Key",
                            SelectedValue = f.Value ?? 0
                        };
                        break;
                    case Kind.Choice:
                        c = new ComboBox { ItemsSource = f.Choices, SelectedItem = f.Value ?? f.Choices[0] };
                        break;
                    case Kind.Date:
                        c = new DatePicker { SelectedDate = (f.Value as DateTime?) ?? DateTime.Today };
                        break;
                    default:
                        c = new TextBox { Text = f.Value == null ? "" : f.Value.ToString(), Padding = new Thickness(3) };
                        break;
                }
                c.IsEnabled = f.Enabled;
                ctl[f.Key] = c;
                panel.Children.Add(c);
            }

            var buttons = new StackPanel
            {
                Orientation = Orientation.Horizontal,
                HorizontalAlignment = HorizontalAlignment.Right,
                Margin = new Thickness(0, 18, 0, 0)
            };
            var btnSave = new Button { Content = "Сохранить", Padding = new Thickness(14, 4, 14, 4), Margin = new Thickness(0, 0, 8, 0), IsDefault = true };
            var btnCancel = new Button { Content = "Отмена", Padding = new Thickness(14, 4, 14, 4), IsCancel = true };
            btnSave.Click += Save_Click;
            buttons.Children.Add(btnSave);
            buttons.Children.Add(btnCancel);
            panel.Children.Add(buttons);
            Content = panel;
        }

        void Err(string m)
        {
            MessageBox.Show(m, "Внимание", MessageBoxButton.OK, MessageBoxImage.Warning);
        }

        void Save_Click(object sender, RoutedEventArgs e)
        {
            var values = new Dictionary<string, object>();
            foreach (var f in fields)
            {
                object v = null;
                switch (f.Kind)
                {
                    case Kind.Lookup:
                        v = ((ComboBox)ctl[f.Key]).SelectedValue ?? 0;
                        if ((int)v == 0 && !f.Nullable) v = null;
                        break;
                    case Kind.Choice:
                        v = ((ComboBox)ctl[f.Key]).SelectedItem;
                        break;
                    case Kind.Date:
                        v = ((DatePicker)ctl[f.Key]).SelectedDate;
                        break;
                    default:
                        string tx = ((TextBox)ctl[f.Key]).Text.Trim();
                        if (tx == "") break;
                        if (f.Kind == Kind.Int)
                        {
                            int i;
                            if (!int.TryParse(tx, out i)) { Err("Поле «" + f.Label + "» должно быть целым числом"); return; }
                            v = i;
                        }
                        else if (f.Kind == Kind.Decimal)
                        {
                            decimal d;
                            if (!decimal.TryParse(tx, out d)) { Err("Поле «" + f.Label + "» должно быть числом"); return; }
                            v = d;
                        }
                        else v = tx;
                        break;
                }
                if (v == null && !f.Nullable) { Err("Заполните поле «" + f.Label + "»"); return; }
                values[f.Key] = v;
            }

            string error;
            try { error = save(values); }
            catch (Exception ex) { error = "Не удалось сохранить запись: " + ex.GetBaseException().Message; }

            if (error != null)
            {
                MessageBox.Show(error, "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
                return;
            }
            DialogResult = true;
        }
    }
}



