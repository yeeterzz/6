using System;
using System.Collections.Generic;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class CarsPage : Page
    {
        public CarsPage()
        {
            InitializeComponent();
            if (Session.Role == Session.Client) TitleText.Text = "Мои автомобили";
            // Клиент – только просмотр
            bool admin = Session.Role == Session.Admin;
            AddBtn.Visibility = EditBtn.Visibility = DelBtn.Visibility = admin ? Visibility.Visible : Visibility.Collapsed;
            LoadData();
        }

        void LoadData()
        {
            int uid = Session.UserId;
            bool isClient = Session.Role == Session.Client;
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    var q = from ca in db.Cars
                            join cl in db.Clients on ca.ClientId equals cl.Id
                            select new { ca.Id, Owner = cl.FullName, ca.Brand, ca.Model, ca.ReleaseYear, ca.PlateNumber, cl.UserId };
                    if (isClient) q = q.Where(x => x.UserId == uid);   // клиент видит только свои автомобили
                    DataList.ItemsSource = q.OrderBy(x => x.Id).ToList();
                }
            }
            catch (Exception ex) { Helpers.ShowError("Ошибка загрузки данных: " + ex.GetBaseException().Message); }
        }

        void DataList_DoubleClick(object sender, System.Windows.Input.MouseButtonEventArgs e)
        {
            if (EditBtn.Visibility == Visibility.Visible && DataList.SelectedItem != null)
                Edit_Click(sender, e);
        }

        void Add_Click(object sender, RoutedEventArgs e)
        {
            if (OpenForm(null)) LoadData();
        }

        void Edit_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null) return;
            if (OpenForm(id.Value)) LoadData();
        }

        void Delete_Click(object sender, RoutedEventArgs e)
        {
            int? id = Helpers.SelectedId(DataList);
            if (id == null || !Helpers.ConfirmDelete()) return;
            try
            {
                using (var db = new AutoServiceEntities())
                {
                    var car = db.Cars.Find(id.Value);
                    if (car != null) { db.Cars.Remove(car); db.SaveChanges(); }
                }
            }
            catch (Exception) { Helpers.ShowError("Запись нельзя удалить: она связана с другими данными (заказы)."); }
            LoadData();
        }

        bool OpenForm(int? id)
        {
            using (var db = new AutoServiceEntities())
            {
                var car = id == null ? new Cars() : db.Cars.Find(id.Value);
                var clients = db.Clients.ToList().Select(x => new KeyValuePair<int, string>(x.Id, x.FullName));

                var fields = new List<FormField> {
                    new FormField { Key = "ClientId", Label = "Владелец", Kind = Kind.Lookup,
                                    Items = Helpers.Pairs(false, clients), Value = id == null ? 0 : car.ClientId },
                    new FormField { Key = "Brand", Label = "Марка", Value = car.Brand },
                    new FormField { Key = "Model", Label = "Модель", Value = car.Model },
                    new FormField { Key = "ReleaseYear", Label = "Год выпуска", Kind = Kind.Int,
                                    Value = id == null ? (int?)null : car.ReleaseYear },
                    new FormField { Key = "PlateNumber", Label = "Гос. номер", Value = car.PlateNumber }
                };
                var form = new FormWindow(id == null ? "Добавление автомобиля" : "Редактирование автомобиля", fields, v =>
                {
                    car.ClientId = (int)v["ClientId"];
                    car.Brand = (string)v["Brand"];
                    car.Model = (string)v["Model"];
                    car.ReleaseYear = (int)v["ReleaseYear"];
                    car.PlateNumber = (string)v["PlateNumber"];
                    if (id == null) db.Cars.Add(car);
                    db.SaveChanges();
                    return null;
                });
                return form.ShowDialog() == true;
            }
        }
    }
