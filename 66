using System;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class UsersPage : Page
    {
        public UsersPage()
        {
            InitializeComponent();

            LoadData();
            // при возврате со страницы редактирования список обновляется
            IsVisibleChanged += (s, e) => { if ((bool)e.NewValue) LoadData(); };
        }

        // Загрузка данных из БД
        void LoadData()
        {
            DGUsers.ItemsSource = App.DB.Users.ToList();
        }

        private void BAdd_Click(object sender, RoutedEventArgs e)
        {
            NavigationService.Navigate(new UserEditPage(new Users()));
        }

        private void BEdit_Click(object sender, RoutedEventArgs e)
        {
            var selected = DGUsers.SelectedItem as Users;
            if (selected == null)
            {
                MessageBox.Show("Выберите запись!");
                return;
            }
            NavigationService.Navigate(new UserEditPage(selected));
        }

        private void BDelete_Click(object sender, RoutedEventArgs e)
        {
            var selected = DGUsers.SelectedItem as Users;
            if (selected == null)
            {
                MessageBox.Show("Выберите запись!");
                return;
            }
            if (selected.Id == App.CurrentUser.Id)
            {
                MessageBox.Show("Нельзя удалить собственную учётную запись");
                return;
            }
            if (MessageBox.Show("Удалить выбранную запись?", "Подтверждение",
                    MessageBoxButton.YesNo, MessageBoxImage.Question) != MessageBoxResult.Yes) return;
            try
            {
                App.DB.Users.Remove(selected);
                App.DB.SaveChanges();
            }
            catch (Exception)
            {
                App.DB.Entry(selected).Reload();
                MessageBox.Show("Запись нельзя удалить: она связана с другими данными.");
            }
            LoadData();
        }
    }
}


