using System;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class CarEditPage : Page
    {
        Cars contextCar;

        public CarEditPage(Cars item)
        {
            InitializeComponent();
            contextCar = item;
            CBClient.ItemsSource = App.DB.Clients.ToList();
            // привязка свойств объекта к полям формы (Binding)
            DataContext = contextCar;
        }

        private void BSave_Click(object sender, RoutedEventArgs e)
        {
            string errorMessage = "";
            if (contextCar.Clients == null)
                errorMessage += "Выберите владельца\n";
            if (string.IsNullOrWhiteSpace(contextCar.Brand))
                errorMessage += "Заполните марку\n";
            if (string.IsNullOrWhiteSpace(contextCar.Model))
                errorMessage += "Заполните модель\n";
            if (contextCar.ReleaseYear < 1950 || contextCar.ReleaseYear > DateTime.Now.Year + 1)
                errorMessage += "Год выпуска должен быть в диапазоне 1950 – " + (DateTime.Now.Year + 1) + "\n";
            if (string.IsNullOrWhiteSpace(contextCar.PlateNumber))
                errorMessage += "Заполните гос. номер\n";
            if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                MessageBox.Show(errorMessage);
                return;
            }

            try
            {
                if (contextCar.Id == 0)
                    App.DB.Cars.Add(contextCar);
                App.DB.SaveChanges();
                // Переход назад после сохранения изменений
                NavigationService.GoBack();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Не удалось сохранить запись: " + ex.GetBaseException().Message);
            }
        }

        private void BCancel_Click(object sender, RoutedEventArgs e)
        {
            App.Discard(contextCar);
            NavigationService.GoBack();
        }
    }
}



