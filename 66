using System;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class CarsPage : Page
    {
        public CarsPage()
        {
            InitializeComponent();
            bool admin = App.CurrentUser.Roles.Name == "Администратор";
            BAdd.Visibility = BEdit.Visibility = BDelete.Visibility = admin ? Visibility.Visible : Visibility.Collapsed;
            if (App.CurrentUser.Roles.Name == "Клиент") TBTitle.Text = "Мои автомобили";
            LoadData();
            // при возврате со страницы редактирования список обновляется
            IsVisibleChanged += (s, e) => { if ((bool)e.NewValue) LoadData(); };
        }

        // Загрузка данных из БД
        void LoadData()
        {
            int uid = App.CurrentUser.Id;
            if (App.CurrentUser.Roles.Name == "Клиент")
                DGCars.ItemsSource = App.DB.Cars.Where(x => x.Clients.UserId == uid).ToList();   // только свои автомобили
            else
                DGCars.ItemsSource = App.DB.Cars.ToList();
        }

        private void BAdd_Click(object sender, RoutedEventArgs e)
        {
            NavigationService.Navigate(new CarEditPage(new Cars()));
        }

        private void BEdit_Click(object sender, RoutedEventArgs e)
        {
            var selected = DGCars.SelectedItem as Cars;
            if (selected == null)
            {
                MessageBox.Show("Выберите запись!");
                return;
            }
            NavigationService.Navigate(new CarEditPage(selected));
        }

        private void BDelete_Click(object sender, RoutedEventArgs e)
        {
            var selected = DGCars.SelectedItem as Cars;
            if (selected == null)
            {
                MessageBox.Show("Выберите запись!");
                return;
            }

            if (MessageBox.Show("Удалить выбранную запись?", "Подтверждение",
                    MessageBoxButton.YesNo, MessageBoxImage.Question) != MessageBoxResult.Yes) return;
            try
            {
                App.DB.Cars.Remove(selected);
                App.DB.SaveChanges();
            }
            catch (Exception)
            {
                App.DB.Entry(selected).Reload();
                MessageBox.Show("Запись нельзя удалить: она связана с другими данными.");
            }
            LoadData();
        }
    }
}


