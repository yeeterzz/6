using System;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace AutoService
{
    public partial class OrdersPage : Page
    {
        public OrdersPage()
        {
            InitializeComponent();
            string role = App.CurrentUser.Roles.Name;
            // админ: добавление/удаление; мастер: только редактирование (статус); клиент: просмотр
            BAdd.Visibility = BDelete.Visibility = role == "Администратор" ? Visibility.Visible : Visibility.Collapsed;
            BEdit.Visibility = role != "Клиент" ? Visibility.Visible : Visibility.Collapsed;
            if (role == "Клиент") TBTitle.Text = "Мои заказы";
            LoadData();
            // при возврате со страницы редактирования список обновляется
            IsVisibleChanged += (s, e) => { if ((bool)e.NewValue) LoadData(); };
        }

        // Загрузка данных из БД
        void LoadData()
        {
            string role = App.CurrentUser.Roles.Name;
            int uid = App.CurrentUser.Id;
            if (role == "Мастер")
                DGOrders.ItemsSource = App.DB.Orders.Where(x => x.MasterId == uid).ToList();             // свои заказы
            else if (role == "Клиент")
                DGOrders.ItemsSource = App.DB.Orders.Where(x => x.Cars.Clients.UserId == uid).ToList();    // свои заказы
            else
                DGOrders.ItemsSource = App.DB.Orders.ToList();
        }

