            CBService.ItemsSource = App.DB.Services.ToList();
            CBMaster.ItemsSource = App.DB.Users.Where(x => x.Roles.Name == "Мастер").ToList();

            // мастер может менять только статус заказа
            if (App.CurrentUser.Roles.Name == "Мастер")
            {
                CBCar.IsEnabled = CBService.IsEnabled = CBMaster.IsEnabled = DPDate.IsEnabled = false;
            }
            // привязка свойств объекта к полям формы (Binding)
            DataContext = contextOrder;
        }

        private void BSave_Click(object sender, RoutedEventArgs e)
        {
            string errorMessage = "";
            if (contextOrder.Cars == null)
                errorMessage += "Выберите автомобиль\n";
            if (contextOrder.Services == null)
                errorMessage += "Выберите услугу\n";
            if (string.IsNullOrWhiteSpace(contextOrder.Status))
                errorMessage += "Выберите статус\n";
            if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                MessageBox.Show(errorMessage);
                return;
            }

            try
            {
                if (contextOrder.Id == 0)
                    App.DB.Orders.Add(contextOrder);
                App.DB.SaveChanges();
                // Переход назад после сохранения изменений
                NavigationService.GoBack();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Не удалось сохранить запись: " + ex.GetBaseException().Message);
            }
        }

        private void BCancel_Click(object sender, RoutedEventArgs e)
        {
            App.Discard(contextOrder);
            NavigationService.GoBack();
        }
    }
}



